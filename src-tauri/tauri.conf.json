{
  "build": {
    "beforeDevCommand": "npm run svelte:dev",
    "beforeBuildCommand": "npm run svelte:build",
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "dmg",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../static/*"
    ]
  },
  "productName": "screen-coreo",
  "mainBinaryName": "screen-coreo",
  "version": "0.1.0",
  "identifier": "com.milan.screen-coreo.app",
  "plugins": {},
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "dangerousDisableAssetCspModification": false,
      "csp": {
        "default-src": ["'self'", "ipc:", "tauri:", "http://ipc.localhost"],
        "img-src": ["'self'", "asset:", "https://asset.localhost", "data:", "blob:"],
        "connect-src": [
          "'self'", 
          "ipc:", 
          "ipc://localhost/*",
          "http://ipc.localhost",
          "asset:", 
          "https://asset.localhost",
          "tauri://localhost",
          "tauri://*"
        ],
        "script-src": ["'self'", "'unsafe-inline'", "'unsafe-eval'", "'wasm-unsafe-eval'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "media-src": ["'self'", "asset:", "https://asset.localhost"],
        "font-src": ["'self'"]
      }
    },
    "windows": [
      {
        "title": "Presentation Controller",
        "height": 300,
        "x": 0,
        "y": 0,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ]
  }
}