{
  "build": {
    "beforeDevCommand": "npm run svelte:dev",
    "beforeBuildCommand": "npm run svelte:build",
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "dmg",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../static/*"
    ]
  },
  "productName": "screen-coreo",
  "mainBinaryName": "screen-coreo",
  "version": "0.1.0",
  "identifier": "com.milan.screen-coreo.app",
  "plugins": {},
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "dangerousDisableAssetCspModification": true,
      "csp": null
    },
    "windows": [
      {
        "title": "Presentation Controller",
        "height": 300,
        "x": 0,
        "y": 0,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "useHttpsScheme": true
      }
    ]
  }
}